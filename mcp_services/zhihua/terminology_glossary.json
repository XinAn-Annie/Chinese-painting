{
  "version": 2,
  "name": "中国画技法术语受控词表",
  "source": "从 ZhiHua_QA 高频技法词与权威博物馆公开资料中人工筛选；只保留可见形式特征，不包含作品、作者、年代、寓意或鉴定信息",
  "references": {
    "dpm_cun": "https://www.dpm.org.cn/lemmas/242610.html",
    "dpm_axe_cut": "https://www.dpm.org.cn/lemmas/243376.html",
    "dpm_three_distances": "https://www.dpm.org.cn/collection/paint/228299.html",
    "dpm_jiehua": "https://www.dpm.org.cn/lemmas/240644.html",
    "dpm_gongxie": "https://www.dpm.org.cn/lemmas/240400.html",
    "dpm_outline_flower_dot_leaf": "https://www.dpm.org.cn/lemmas/239344.html",
    "dpm_rendering": "https://www.dpm.org.cn/collection/paint/234540.html",
    "dpm_xiasan": "https://www.dpm.org.cn/collection/paint/228384.html",
    "dpm_niu_mao": "https://www.dpm.org.cn/collection/paint/257004.html",
    "dpm_blank_space": "https://www.dpm.org.cn/collection/paint/231775.html",
    "met_line": "https://www.metmuseum.org/exhibitions/listings/2010/xie-zhiliu",
    "cuhk_texture_strokes": "https://www.artmuseum.cuhk.edu.hk/en/exhibition/current/detail/66"
  },
  "entries": [
    {
      "term": "披麻皴",
      "label": "披麻皴倾向",
      "definition": "以较长、柔韧、相互交叠的线条顺着山石结构反复皴擦，常用于表现土质山体的绵密纹理。",
      "evidence_groups": [
        ["长而.*线条", "长线.*皴", "柔韧.*线条", "松动.*皴笔", "条带状.*皴"],
        ["山石", "山体", "坡石", "山峦"],
        ["皴", "皴擦", "纹理"]
      ]
    },
    {
      "term": "斧劈皴",
      "label": "斧劈皴倾向",
      "definition": "以侧锋形成棱角鲜明、近似斧削的块面或短促皴笔，强调坚硬陡峭的山石结构。",
      "evidence_groups": [
        ["斧削", "刀削", "棱角.*块面", "块面.*锐利", "短促.*侧锋"],
        ["山石", "山体", "峭壁", "岩石"]
      ]
    },
    {
      "term": "米点皴",
      "label": "米点皴倾向",
      "definition": "以密集的横点、圆点或湿润墨点积聚成山体与烟云效果。",
      "evidence_groups": [
        ["横点", "圆点", "密集.*墨点", "点状.*墨", "湿润.*墨点"],
        ["山体", "山峦", "山石", "烟云", "云气"]
      ]
    },
    {
      "term": "积墨",
      "label": "积墨法",
      "definition": "待前一层墨色基本稳定后反复叠加，使墨层逐渐厚重并形成丰富层次。",
      "evidence_groups": [
        ["反复.*叠墨", "层层.*叠加.*墨", "多次.*叠加.*墨", "墨色.*逐层.*加深"]
      ]
    },
    {
      "term": "破墨",
      "label": "破墨法",
      "definition": "趁墨色未干时加入不同浓淡或水分，使墨色相互渗化、冲破边界。",
      "evidence_groups": [
        ["未干.*加入.*墨", "浓淡墨.*渗", "墨色.*相互.*渗", "水分.*冲开.*墨", "墨色.*冲破"]
      ]
    },
    {
      "term": "泼墨",
      "label": "泼墨倾向",
      "definition": "以较大面积、较强水分的墨色泼写或铺陈，重视墨色自然流动形成的整体气势。",
      "evidence_groups": [
        ["大片.*墨色", "大面积.*墨", "泼洒.*墨", "墨色.*淋漓", "水墨.*泼写"]
      ]
    },
    {
      "term": "飞白",
      "label": "飞白效果",
      "definition": "运笔较快或笔中水墨较少时，笔画内部露出丝状、断续的纸白。",
      "evidence_groups": [
        ["笔触.*露白", "笔画.*露白", "丝状.*白", "断续.*白痕", "墨线.*露出.*纸白"]
      ]
    },
    {
      "term": "枯笔",
      "label": "枯笔",
      "definition": "笔中水分较少，形成干涩、毛糙、断续的墨迹。",
      "evidence_groups": [
        ["干涩.*笔", "毛糙.*墨", "笔触.*干枯", "墨迹.*干涩", "干笔.*断续"]
      ]
    },
    {
      "term": "湿笔",
      "label": "湿笔",
      "definition": "笔中含水较多，墨色湿润、边缘较柔和，并可能产生自然渗化。",
      "evidence_groups": [
        ["水分.*较多", "墨色.*湿润", "边缘.*柔和.*渗", "水墨.*渗化", "湿润.*笔触"]
      ]
    },
    {
      "term": "没骨",
      "label": "没骨法倾向",
      "definition": "不以清晰墨线勾出轮廓，而直接用色或墨塑造物象的形体。",
      "evidence_groups": [
        ["不勾.*轮廓", "没有.*轮廓线", "不以.*墨线", "直接.*色墨.*塑造", "直接.*颜色.*成形"],
        ["花", "叶", "鸟", "果实", "物象", "形体"]
      ]
    },
    {
      "term": "白描",
      "label": "白描倾向",
      "definition": "主要依靠单色线条塑造形象，通常少设色或不设色。",
      "evidence_groups": [
        ["单色.*线条", "只用.*线条", "以线.*造型", "线条.*塑造"],
        ["不设色", "少设色", "几乎没有.*颜色", "颜色.*很少"]
      ]
    },
    {
      "term": "工笔",
      "label": "工笔倾向",
      "definition": "以细密、工整的线条和较为细致的层层描绘塑造对象。",
      "evidence_groups": [
        ["线条.*细密", "轮廓.*工整", "刻画.*细致", "细节.*精细", "层层.*晕染"],
        ["人物", "花鸟", "衣纹", "羽毛", "花瓣", "物象", "细节"]
      ]
    },
    {
      "term": "写意",
      "label": "写意倾向",
      "definition": "以概括、简练的笔墨抓取对象主要特征，不追求逐一刻画细节。",
      "evidence_groups": [
        ["笔墨.*概括", "用笔.*简练", "省略.*细节", "不拘泥.*细节", "大笔.*概括"],
        ["物象", "形态", "对象", "花鸟", "山水", "人物"]
      ]
    },
    {
      "term": "青绿设色",
      "label": "青绿设色倾向",
      "definition": "山水画中以青、绿色为主要色调的设色方式；仅凭图像通常无法确认具体矿物颜料。",
      "evidence_groups": [
        ["青绿.*山", "山体.*青绿", "蓝绿.*山", "青色.*绿色.*山", "石青.*石绿"],
        ["设色", "着色", "颜色", "色调", "铺色"]
      ]
    },
    {
      "term": "浅绛设色",
      "label": "浅绛设色倾向",
      "definition": "水墨山水中辅以淡赭、花青等较浅色彩的设色方式。",
      "evidence_groups": [
        ["淡赭", "浅赭", "赭色", "赭石色"],
        ["淡墨", "水墨", "花青", "山水", "山石"]
      ]
    },
    {
      "term": "晕染",
      "label": "晕染",
      "definition": "利用水分使墨色或颜色由深到浅自然过渡。",
      "preserve_as_natural_language": true,
      "evidence_groups": [
        ["由深到浅.*过渡", "颜色.*渐变", "墨色.*渐变", "色彩.*自然.*过渡", "水分.*扩散"]
      ]
    },
    {
      "term": "设色",
      "label": "设色",
      "definition": "在画面中施加颜色并组织色彩层次的处理方式。",
      "preserve_as_natural_language": true,
      "evidence_groups": [
        ["局部.*着色", "施加.*颜色", "颜色.*铺陈", "色彩.*点染", "淡彩.*铺染"]
      ]
    },
    {
      "term": "解索皴",
      "label": "解索皴倾向",
      "definition": "以中锋写出屈曲而密集、近似解开绳索的线条，用来组织山体的纹理脉络。",
      "source_refs": ["dpm_xiasan", "dpm_cun"],
      "evidence_groups": [
        ["屈曲.*线条", "线条.*屈曲", "曲折.*密集.*线", "线条.*像.*绳索", "绳索状.*线"],
        ["山石", "山体", "山峦", "坡石"],
        ["纹理", "脉络", "皴擦", "皴线"]
      ]
    },
    {
      "term": "牛毛皴",
      "label": "牛毛皴倾向",
      "definition": "以纤细、密集、往往略带弯曲的线条反复皴写山体，线形近似牛毛。",
      "source_refs": ["dpm_niu_mao", "dpm_cun"],
      "evidence_groups": [
        ["细长.*密集.*线", "细密.*长线", "牛毛状.*线", "纤细.*弯曲.*线"],
        ["山石", "山体", "山峦", "坡石"],
        ["纹理", "皴擦", "表面", "脉络"]
      ]
    },
    {
      "term": "雨点皴",
      "label": "雨点皴倾向",
      "definition": "用密集、短促、近于垂直落下的点状笔触塑造山石表面和体积。",
      "source_refs": ["dpm_cun", "cuhk_texture_strokes"],
      "evidence_groups": [
        ["短促.*竖点", "密集.*点状.*笔触", "雨点状.*墨点", "垂直.*短点"],
        ["山石", "山体", "山峦", "岩壁"],
        ["纹理", "质感", "表面", "体积"]
      ]
    },
    {
      "term": "卷云皴",
      "label": "卷云皴倾向",
      "definition": "用卷曲、回旋、近似云团的弧线组织山石纹理。",
      "source_refs": ["dpm_three_distances", "dpm_cun"],
      "evidence_groups": [
        ["卷曲.*线条", "云团状.*曲线", "弧形.*回旋.*线", "旋卷.*线"],
        ["山石", "山体", "山峦", "岩石"],
        ["纹理", "皴擦", "表面", "脉络"]
      ]
    },
    {
      "term": "点苔",
      "label": "点苔倾向",
      "definition": "在山石、坡面或山脊上配置深浅、大小和聚散不同的墨点，以丰富表面层次或表示植被。",
      "source_refs": ["dpm_rendering", "dpm_niu_mao"],
      "evidence_groups": [
        ["浓墨.*小点", "深色.*墨点", "大小.*墨点", "点状.*深墨"],
        ["山顶", "山脊", "坡面", "石面", "山石", "岩石"],
        ["散布", "聚散", "错落", "点在", "分布"]
      ]
    },
    {
      "term": "渲染",
      "label": "渲染倾向",
      "definition": "在皴擦处略敷水墨或色彩，并以较大面积湿笔在形象周围着墨或着色，以形成衬托和层次。",
      "preserve_as_natural_language": true,
      "source_refs": ["dpm_rendering"],
      "evidence_groups": [
        ["大面积.*湿墨", "外围.*着墨", "轮廓外.*铺.*墨", "皴擦处.*淡墨", "背景.*湿润.*铺染"],
        ["烘托", "衬托", "柔化", "过渡", "层次"]
      ]
    },
    {
      "term": "勾花点叶",
      "label": "勾花点叶倾向",
      "definition": "花朵先以线条勾出轮廓，叶片则直接以色或墨点染。",
      "source_refs": ["dpm_outline_flower_dot_leaf"],
      "evidence_groups": [
        ["花.*线条.*勾.*轮廓", "线条.*勾.*花", "花朵.*轮廓线"],
        ["叶.*色墨.*点", "叶片.*直接.*点染", "叶.*墨点", "叶片.*色点"]
      ]
    },
    {
      "term": "兼工带写",
      "label": "兼工带写倾向",
      "definition": "轮廓或局部线条较为工整，而墨色、颜色或其他部分的处理较为概括、松动。",
      "source_refs": ["dpm_gongxie"],
      "evidence_groups": [
        ["线条.*工整", "轮廓.*工整", "局部.*精细", "细节.*精细"],
        ["敷染.*粗放", "墨色.*粗放", "颜色.*概括", "大片.*概括", "笔触.*松动"]
      ]
    },
    {
      "term": "界画",
      "label": "界画倾向",
      "definition": "以宫室、楼台、屋木等建筑为对象，并以笔直、均匀、规整的线条组织结构；仅凭成图不能确认是否实际使用界尺。",
      "source_refs": ["dpm_jiehua"],
      "evidence_groups": [
        ["建筑", "楼阁", "宫室", "屋宇", "亭台"],
        ["横平竖直", "笔直.*线", "粗细.*均匀.*直线", "规整.*平行线", "尺规般.*线"]
      ]
    },
    {
      "term": "平远",
      "label": "平远构图倾向",
      "definition": "由近处平视远处，景物多沿水平方向展开，近景、中景与远景形成开阔层次。",
      "source_refs": ["dpm_three_distances"],
      "evidence_groups": [
        ["近景.*远山", "近岸.*远山", "前景.*远景", "近处.*远处"],
        ["横向.*展开", "视平线.*较低", "平视", "水面.*开阔", "远山.*低平"],
        ["山水", "山体", "山峦", "远山"]
      ]
    },
    {
      "term": "高远",
      "label": "高远构图倾向",
      "definition": "从山下仰观山巅，以向上的视线和高耸主峰强化垂直空间。",
      "source_refs": ["dpm_three_distances"],
      "evidence_groups": [
        ["仰视", "由下.*向上", "山脚.*山顶", "低处.*高峰"],
        ["主峰.*高耸", "山峰.*上升", "峰顶", "山巅"],
        ["山水", "山体", "山峦", "高峰"]
      ]
    },
    {
      "term": "深远",
      "label": "深远构图倾向",
      "definition": "从山前向山后或由前景向深处组织重叠层次，使空间向画面内部延伸。",
      "source_refs": ["dpm_three_distances"],
      "evidence_groups": [
        ["前山.*后山", "山前.*山后", "层层.*深入", "由前景.*中景.*远景", "峰峦.*重叠"],
        ["纵深", "深处", "幽深", "向画面.*延伸"],
        ["山水", "山体", "山峦", "山峰"]
      ]
    },
    {
      "term": "勾勒",
      "label": "勾勒",
      "definition": "以线条明确物象的外轮廓或结构边界，是中国画以线造型的基本方式之一。",
      "preserve_as_natural_language": true,
      "source_refs": ["met_line"],
      "evidence_groups": [
        ["轮廓.*线条", "线条.*勾出.*轮廓", "墨线.*界定.*形体", "外轮廓.*清晰"],
        ["人物", "花叶", "花朵", "山石", "建筑", "物象", "形体"]
      ]
    },
    {
      "term": "散点透视",
      "label": "散点透视倾向",
      "definition": "画面不固定于单一视点，而把移动观看所得的多个视点组织在连续空间中，常见于手卷。",
      "source_refs": ["dpm_niu_mao"],
      "evidence_groups": [
        ["不同.*视点", "多个.*视角", "视点.*移动", "步移景异", "边走边看"],
        ["长卷", "手卷", "连续.*场景", "分段.*景物", "多段.*空间"]
      ]
    },
    {
      "term": "小青绿",
      "label": "小青绿设色倾向",
      "definition": "在水墨淡彩基础上薄施青绿色的山水设色方式；仅凭数字图像不能确认是否使用石青、石绿等矿物颜料。",
      "source_refs": ["dpm_niu_mao"],
      "evidence_groups": [
        ["青绿.*淡", "浅淡.*青绿", "淡青.*淡绿", "青绿色.*薄"],
        ["水墨", "墨色", "淡墨", "山水", "山体"],
        ["薄罩", "淡彩", "轻染", "浅设色"]
      ]
    },
    {
      "term": "留白",
      "label": "留白构图",
      "definition": "有意识地保留未着墨或少着墨区域，使其参与表现水面、天空、云雾、雪景或画面虚实关系。",
      "preserve_as_natural_language": true,
      "source_refs": ["dpm_blank_space"],
      "evidence_groups": [
        ["大片.*空白", "大面积.*未着墨", "纸面.*保留.*空白", "背景.*几乎.*空白", "留出.*空白"],
        ["水面", "天空", "云雾", "空间", "背景", "雪"]
      ]
    }
  ]
}
